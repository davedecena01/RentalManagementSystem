# ============================================================
# Rental Property Manager — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================


# ------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ------------------------------------------------------------
# Found in: Supabase Dashboard → Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:<password>@<project>.supabase.co:5432/postgres


# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
# Found in: Supabase Dashboard → Settings → API

# Your Supabase project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Anon/public key — safe for frontend
SUPABASE_ANON_KEY=

# Service role key — backend only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret — used by .NET API to validate Supabase JWTs
# Found in: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=


# ------------------------------------------------------------
# Stripe
# ------------------------------------------------------------
# Found in: Stripe Dashboard → Developers → API Keys

# Secret key (backend only — never expose to client)
STRIPE_SECRET_KEY=sk_test_

# Publishable key (safe for frontend)
STRIPE_PUBLISHABLE_KEY=pk_test_

# Webhook signing secret
# Found in: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing Secret
# For local dev, get this from: stripe listen --forward-to localhost:...
STRIPE_WEBHOOK_SECRET=whsec_


# ------------------------------------------------------------
# SendGrid
# ------------------------------------------------------------
# Found in: SendGrid Dashboard → Settings → API Keys

SENDGRID_API_KEY=SG.

# Must be a verified sender in SendGrid
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Rental Property Manager


# ------------------------------------------------------------
# Internal Security
# ------------------------------------------------------------
# Secret key used to protect the internal reminder trigger endpoint
# Generate a strong random string (e.g., openssl rand -hex 32)
INTERNAL_API_KEY=


# ------------------------------------------------------------
# PDF Generation
# ------------------------------------------------------------
# Supabase Storage bucket for generated PDFs (lease agreements and receipts)
PDF_STORAGE_BUCKET=lease-documents


# ------------------------------------------------------------
# Demo Mode
# ------------------------------------------------------------
# Set to true to enable the DatabaseSeeder and POST /api/seed endpoint.
# NEVER set to true in production. Only used on the demo/staging deployment.
DEMO_MODE=false


# ------------------------------------------------------------
# App URLs
# ------------------------------------------------------------
# Frontend URL — used for CORS and Stripe success/cancel redirect URLs
FRONTEND_URL=http://localhost:4200

# Backend API URL — used by the Angular frontend
API_URL=https://localhost:7000/api


# ------------------------------------------------------------
# ASP.NET Core
# ------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# Port for the backend (Railway injects this automatically in production)
PORT=8080


# ------------------------------------------------------------
# Angular Frontend (set in environment.ts or as Vercel env vars)
# ------------------------------------------------------------
# These are used in the Angular environment files, not in .env directly.
# List them here for reference when configuring Vercel or CI.

# ANGULAR_API_URL=https://<api-host>/api
# ANGULAR_SUPABASE_URL=https://<project-ref>.supabase.co
# ANGULAR_SUPABASE_ANON_KEY=
# ANGULAR_STRIPE_PUBLISHABLE_KEY=pk_test_
